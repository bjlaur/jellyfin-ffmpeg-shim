{
  "shim": {
    "kill_switch": false,
    "enable_hdr_to_hdr": true,
    "enable_bitrate_min": true,
    "enable_client_allow_deny": true,
    "enable_filter_complex_hdr_to_hdr": true,
    "enable_opencl_subtitle_compositor": true,
    "enable_diagnostic_overlay": false,
    "log_full_argv": true
  },
  "jellyfin": {
    "url": "http://127.0.0.1:8096",
    "api_key": "PASTE_YOUR_API_KEY_HERE"
  },
  "paths": {
    "ffmpeg_binary": "/usr/lib/jellyfin-ffmpeg/ffmpeg",
    "ffprobe_binary": "/usr/lib/jellyfin-ffmpeg/ffprobe",
    "log_file": "/var/log/jellyfin/jellyfin-ffmpeg-shim.log"
  },
  "tuning": {
    "minrate_ratio": 0.70,
    "diagnostic_overlay_duration_seconds": 15.0,
    "blocking_decision_poll_delays_seconds": [0.0, 0.25, 0.75, 1.5, 2.5],
    "blocking_decision_api_timeout_seconds": 1.0,
    "source_probe_timeout_seconds": 2.0
  },
  "hdr_access": {
    "allow_list": [
      {
        "username": "example_user",
        "devices": ["living room tv", "chrome"]
      }
    ],
    "deny_list": [
      {
        "username": "example_user",
        "devices": ["firefox"]
      },
      {
        "username": "guest"
      }
    ]
  }
}
