def log(msg: str = "") -> None:
    global _LOG_FAILURE_REPORTED
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(msg)
            if not msg.endswith("\n"):
                f.write("\n")
    except Exception as error:
        # Logging must never break playback, but one stderr diagnostic will be
        # captured in Jellyfin's FFmpeg log and prevents silent failures.
        if not _LOG_FAILURE_REPORTED:
            _LOG_FAILURE_REPORTED = True
            try:
                print(
                    f"jellyfin-ffmpeg-shim: cannot write log {LOG_FILE!r}: "
                    f"{type(error).__name__}: {error}",
                    file=sys.stderr,
                )
            except Exception:
                pass


def shell_join(argv):
    return " ".join(shlex.quote(x) for x in argv)


def has_option(argv, option_names):
    return any(arg in option_names for arg in argv)


def get_option_value(argv, option_names):
    for i, arg in enumerate(argv[:-1]):
        if arg in option_names:
            return argv[i + 1]
    return None


def normalize_file_arg(value: str) -> str:
    if value.startswith("file:"):
        value = value[5:]
    return value


def parse_ffmpeg_argv_for_decision(argv):
    inputs = []
    output_paths = []
    hls_stems = []

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "-i" and i + 1 < len(argv):
            inputs.append(normalize_file_arg(argv[i + 1]))
            i += 2
            continue
        if arg == "-hls_segment_filename" and i + 1 < len(argv):
            segment_name = os.path.basename(argv[i + 1])
            stem = segment_name.replace("%d", "")
            if stem:
                hls_stems.append(stem)
            i += 2
            continue
        i += 1

    if argv and not argv[-1].startswith("-"):
        output_paths.append(normalize_file_arg(argv[-1]))

    return {
        "inputs": inputs,
        "input_basenames": [os.path.basename(x) for x in inputs if x],
        "output_paths": output_paths,
        "output_basenames": [os.path.basename(x) for x in output_paths if x],
        "hls_stems": hls_stems,
    }


def probe_source_hdr_compatibility(argv, report):
    decision = {
        "allow_hdr_preservation": False,
        "reason": "source probe did not run",
        "summary": None,
        "probe_attempted": True,
    }
    parsed = parse_ffmpeg_argv_for_decision(argv)
    local_inputs = [path for path in parsed["inputs"] if path and os.path.isabs(path)]

    if len(local_inputs) != 1:
        decision["reason"] = f"expected one absolute local input, found {len(local_inputs)}"
        report["source_probe"].append(f"DENY: {decision['reason']}")
        return decision

    input_path = local_inputs[0]
    command = [
        FFPROBE_BINARY,
        "-v", "error",
        "-select_streams", "v:0",
        "-show_entries",
        "stream=codec_name,profile,pix_fmt,color_range,color_space,color_transfer,color_primaries:stream_side_data",
        "-of", "json",
        input_path,
    ]

    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=SOURCE_PROBE_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        decision["reason"] = f"ffprobe timed out after {SOURCE_PROBE_TIMEOUT_SECONDS}s"
        report["source_probe"].append(f"DENY: {decision['reason']}")
        return decision
    except Exception as error:
        decision["reason"] = f"ffprobe failed: {type(error).__name__}: {error}"
        report["source_probe"].append(f"DENY: {decision['reason']}")
        return decision

    if completed.returncode != 0:
        stderr = completed.stderr.strip().replace("\n", " ")[:300]
        decision["reason"] = f"ffprobe exited {completed.returncode}: {stderr}"
        report["source_probe"].append(f"DENY: {decision['reason']}")
        return decision

    try:
        data = json.loads(completed.stdout)
        streams = data.get("streams") or []
        if len(streams) != 1 or not isinstance(streams[0], dict):
            raise ValueError(f"expected one video stream result, found {len(streams)}")
        stream = streams[0]
    except Exception as error:
        decision["reason"] = f"invalid ffprobe JSON: {type(error).__name__}: {error}"
        report["source_probe"].append(f"DENY: {decision['reason']}")
        return decision

    dovi = None
    for side_data in stream.get("side_data_list") or []:
        if isinstance(side_data, dict) and side_data.get("side_data_type") == "DOVI configuration record":
            dovi = side_data
            break

    summary = {
        "codec_name": stream.get("codec_name"),
        "profile": stream.get("profile"),
        "pix_fmt": stream.get("pix_fmt"),
        "color_range": stream.get("color_range"),
        "color_space": stream.get("color_space"),
        "color_transfer": stream.get("color_transfer"),
        "color_primaries": stream.get("color_primaries"),
        "dv_profile": dovi.get("dv_profile") if dovi else None,
        "dv_level": dovi.get("dv_level") if dovi else None,
        "dv_bl_present": dovi.get("bl_present_flag") if dovi else None,
        "dv_bl_compatibility_id": dovi.get("dv_bl_signal_compatibility_id") if dovi else None,
    }
    decision["summary"] = summary

    is_hdr10_base = bool(
        stream.get("codec_name") == "hevc"
        and stream.get("pix_fmt") in {"yuv420p10le", "p010le"}
        and stream.get("color_primaries") == "bt2020"
        and stream.get("color_transfer") == "smpte2084"
        and stream.get("color_space") in {"bt2020nc", "bt2020c"}
    )

    if dovi:
        dv_profile = dovi.get("dv_profile")
        if dv_profile == 5:
            decision["reason"] = "Dolby Vision Profile 5 has no HDR10 fallback"
        elif dv_profile not in {7, 8}:
            decision["reason"] = f"unsupported Dolby Vision profile {dv_profile!r}"
        elif dovi.get("bl_present_flag") != 1:
            decision["reason"] = "Dolby Vision base layer is not present"
        elif not is_hdr10_base:
            decision["reason"] = "Dolby Vision base layer is not signaled as HDR10 BT.2020/PQ"
        else:
            decision["allow_hdr_preservation"] = True
            decision["reason"] = "Dolby Vision source has an HDR10-compatible base layer"
    elif is_hdr10_base:
        decision["allow_hdr_preservation"] = True
        decision["reason"] = "source is HDR10 BT.2020/PQ"
    else:
        decision["reason"] = "source is not verified HDR10 BT.2020/PQ"

    report["source_probe"].append(
        f"DECISION: {'ALLOW' if decision['allow_hdr_preservation'] else 'DENY'} "
        f"reason={decision['reason']!r} summary={summary}"
    )
    return decision


def api_get_sessions():
    # Do not use ActiveWithinSeconds here. Jellyfin may not update the initiating
    # session's activity timestamp before spawning FFmpeg, which can hide the very
    # session this blocking decision needs to inspect.
    url = JELLYFIN_URL.rstrip("/") + "/Sessions"
    request = urllib.request.Request(
        url,
        headers={
            "X-Emby-Token": JELLYFIN_API_KEY,
            "Accept": "application/json",
        },
    )
    with urllib.request.urlopen(
        request, timeout=BLOCKING_DECISION_API_TIMEOUT_SECONDS
    ) as response:
        data = json.loads(response.read().decode("utf-8"))
    if not isinstance(data, list):
        raise ValueError("/Sessions response was not a JSON array")
    return data


def score_session_for_decision(session, parsed):
    score = 0
    reasons = []
    session_text = json.dumps(session, ensure_ascii=False, sort_keys=True).lower()
    now_playing = session.get("NowPlayingItem") or {}
    has_transcoding_info = bool(session.get("TranscodingInfo"))

    if has_transcoding_info:
        score += 20
        reasons.append("has TranscodingInfo")
    if now_playing:
        score += 10
        reasons.append("has NowPlayingItem")

    for path in parsed["inputs"]:
        if path and path.lower() in session_text:
            score += 100
            reasons.append("matched full input path")
    for basename in parsed["input_basenames"]:
        if basename and basename.lower() in session_text:
            score += 50
            reasons.append("matched input basename")
    for basename in parsed["output_basenames"]:
        if basename and basename.lower() in session_text:
            score += 25
            reasons.append("matched output basename")
    for stem in parsed["hls_stems"]:
        if stem and stem.lower() in session_text:
            score += 25
            reasons.append("matched HLS output stem")

    return {
        "score": score,
        "reasons": reasons,
        "has_transcoding_info": has_transcoding_info,
        "user_name": session.get("UserName"),
        "device_name": session.get("DeviceName"),
        "device_id": session.get("DeviceId"),
        "client": session.get("Client"),
        "now_playing_path": now_playing.get("Path"),
    }


def decide_session_candidate(scored):
    if not scored:
        return None, "low", "no active sessions"

    ordered = sorted(scored, key=lambda item: item["score"], reverse=True)
    best = ordered[0]
    tied_best = [item for item in ordered if item["score"] == best["score"]]

    if best["score"] >= 100 and len(tied_best) == 1:
        return best, "high", "unique path-based match"

    transcodes = [item for item in ordered if item["has_transcoding_info"]]
    if len(transcodes) == 1:
        return transcodes[0], "medium", "exactly one active transcoding session"
    if len(transcodes) > 1:
        return None, "low", "multiple ambiguous transcoding sessions"
    return None, "low", "no active transcoding session"


def apply_client_allowlist(candidate):
    user_name = candidate.get("user_name")
    device_name = candidate.get("device_name")

    normalized_user = user_name.casefold() if isinstance(user_name, str) else ""
    normalized_device = device_name.casefold() if isinstance(device_name, str) else ""

    def matches(rule):
        if rule["username"].casefold() != normalized_user:
            return False
        devices = rule.get("devices")
        if devices is None:
            return True
        return normalized_device in {device.casefold() for device in devices}

    if any(matches(rule) for rule in HDR_DENY_LIST):
        return False, "matched deny rule"
    if any(matches(rule) for rule in HDR_ALLOW_LIST):
        return True, "matched allow rule"
    return False, "no matching allow rule"


def blocking_client_decision(argv, report):
    decision = {
        "allow_hdr_to_hdr": False,
        "reason": "blocking decision did not run",
        "confidence": "low",
        "session": None,
    }

    if ENABLE_BLOCKING_CLIENT_DECISION != 1:
        decision["reason"] = "ENABLE_BLOCKING_CLIENT_DECISION=0"
        report["blocking_client_decision"].append("DISABLED: ENABLE_BLOCKING_CLIENT_DECISION=0")
        return decision
    if not JELLYFIN_API_KEY or JELLYFIN_API_KEY == "PASTE_YOUR_API_KEY_HERE":
        decision["reason"] = "API key missing"
        report["blocking_client_decision"].append("BAIL: API key missing")
        return decision

    parsed = parse_ffmpeg_argv_for_decision(argv)
    previous_delay = 0.0
    last_reason = "no poll completed"

    for delay in BLOCKING_DECISION_POLL_DELAYS_SECONDS:
        sleep_for = max(0.0, delay - previous_delay)
        previous_delay = delay
        if sleep_for:
            time.sleep(sleep_for)

        try:
            sessions = api_get_sessions()
            scored = [score_session_for_decision(s, parsed) for s in sessions]
            candidate, confidence, candidate_reason = decide_session_candidate(scored)
            best = max(scored, key=lambda item: item["score"], default=None)
            report["blocking_client_decision"].append(
                "POLL: "
                f"delay={delay} session_count={len(sessions)} "
                f"best_score={best.get('score') if best else None} "
                f"user={best.get('user_name') if best else None!r} "
                f"device={best.get('device_name') if best else None!r} "
                f"client={best.get('client') if best else None!r}"
            )
            last_reason = candidate_reason

            if candidate is not None:
                allow, allow_reason = apply_client_allowlist(candidate)
                decision.update({
                    "allow_hdr_to_hdr": allow,
                    "reason": allow_reason,
                    "confidence": confidence,
                    "session": candidate,
                })
                report["blocking_client_decision"].append(
                    f"DECISION: {'ALLOW' if allow else 'DENY'} "
                    f"confidence={confidence} user={candidate['user_name']!r} "
                    f"device={candidate['device_name']!r} reason={allow_reason!r}"
                )
                return decision
        except Exception as error:
            last_reason = f"Jellyfin API error: {type(error).__name__}: {error}"
            report["blocking_client_decision"].append(
                f"POLL_ERROR: delay={delay} error={type(error).__name__}: {error}"
            )

    decision["reason"] = last_reason
    report["blocking_client_decision"].append(f"DECISION: DENY reason={last_reason!r}")
    return decision


def parse_bitrate_to_bits(value: str):
    value = value.strip().lower()
    multiplier = 1

    if value.endswith("k"):
        multiplier = 1_000
        value = value[:-1]
    elif value.endswith("m"):
        multiplier = 1_000_000
        value = value[:-1]
    elif value.endswith("g"):
        multiplier = 1_000_000_000
        value = value[:-1]

    try:
        return int(float(value) * multiplier)
    except ValueError:
        return None


def apply_minrate_from_maxrate(argv):
    """
    Global rewrite:
      -maxrate X      -> -minrate 70%X -maxrate X
      -maxrate:v:0 X  -> -minrate:v:0 70%X -maxrate:v:0 X
    """
    out = argv[:]
    changes = []
    targets = []

    for i, arg in enumerate(argv[:-1]):
        if arg == "-maxrate" or arg.startswith("-maxrate:"):
            maxrate_value = argv[i + 1]
            maxrate_bits = parse_bitrate_to_bits(maxrate_value)

            if maxrate_bits is None:
                changes.append(f"BAIL: could not parse {arg} {maxrate_value!r}")
                continue

            minrate_bits = int(maxrate_bits * MINRATE_RATIO)
            suffix = arg[len("-maxrate"):]
            minrate_opt = "-minrate" + suffix

            targets.append((arg, minrate_opt, str(minrate_bits), maxrate_value))

    # Deduplicate by minrate option, keeping the last matching target.
    deduped = {}
    for max_opt, min_opt, min_value, max_value in targets:
        deduped[min_opt] = (max_opt, min_value, max_value)

    for min_opt, (max_opt, min_value, max_value) in deduped.items():
        existing_index = None

        for j in range(len(out) - 1):
            if out[j] == min_opt:
                existing_index = j
                break

        if existing_index is not None:
            old = out[existing_index + 1]
            out[existing_index + 1] = min_value
            changes.append(f"UPDATED: {min_opt} {old} -> {min_value}")
            continue

        insert_index = None

        for j in range(len(out) - 1):
            if out[j] == max_opt and out[j + 1] == max_value:
                insert_index = j
                break

        if insert_index is None:
            for j in range(len(out) - 1):
                if out[j] == max_opt:
                    insert_index = j
                    break

        if insert_index is not None:
            out[insert_index:insert_index] = [min_opt, min_value]
            changes.append(f"ADDED: {min_opt} {min_value} from {max_opt} {max_value}")

    return out, changes


def is_hdr_to_sdr_filter(value: str) -> bool:
    return all(marker in value for marker in HDR_TO_SDR_MARKERS)


def filter_contains_hdr_to_sdr_tonemap(value: str | None) -> bool:
    if not value:
        return False
    return is_hdr_to_sdr_filter(value)


def replace_tonemapx_with_hdr_to_hdr(value: str) -> tuple[str, str]:
    pattern = (
        r"tonemapx=tonemap=bt2390"
        r"(?::[^,;\[\]]*)?"
        r":t=bt709:m=bt709:p=bt709:format=yuv420p"
    )

    new_value, count = re.subn(pattern, HDR_TO_HDR_FILTER, value)

    if count > 0:
        return new_value, f"regex replacement count={count}"

    # Fallback for slightly different ordering/extra args after detection.
    start = value.find("tonemapx=tonemap=bt2390")
    if start == -1:
        return value, "BAIL: start marker not found during replacement"

    end_candidates = []
    for sep in [",", ";", "["]:
        idx = value.find(sep, start)
        if idx != -1:
            end_candidates.append(idx)

    end = min(end_candidates) if end_candidates else len(value)
    new_value = value[:start] + HDR_TO_HDR_FILTER + value[end:]

    return new_value, "fallback replacement used"


def replace_vaapi_tonemap_with_hdr(value: str) -> tuple[str, str]:
    parts = value.split(",")
    rewritten = []
    removed_procamp = 0
    replaced_tonemap = 0

    for part in parts:
        name = part.strip()
        if name.startswith("procamp_vaapi="):
            removed_procamp += 1
            continue
        if name.startswith("tonemap_vaapi="):
            rewritten.append(HDR_VAAPI_FILTER)
            replaced_tonemap += 1
            continue
        rewritten.append(part)

    if replaced_tonemap != 1:
        return value, f"BAIL: expected one tonemap_vaapi filter, found {replaced_tonemap}"

    return ",".join(rewritten), (
        f"removed SDR tonemap_vaapi and inserted HDR-preserving scale_vaapi count={replaced_tonemap}; "
        f"removed procamp_vaapi count={removed_procamp}"
    )


def set_or_add_option(argv, option_names, value, insert_before_last=True):
    out = []
    changed = False
    actions = []
    i = 0

    while i < len(argv):
        out.append(argv[i])

        if argv[i] in option_names and i + 1 < len(argv):
            old = argv[i + 1]
            out.append(value)
            actions.append(f"UPDATED: {argv[i]} {old} -> {value}")
            i += 2
            changed = True
            continue

        i += 1

    if not changed and insert_before_last and len(out) >= 1:
        out = out[:-1] + [option_names[0], value] + out[-1:]
        actions.append(f"ADDED: {option_names[0]} {value}")

    return out, actions


def rewrite_x265_params(params: str) -> tuple[str, list[str]]:
    parts = [p for p in params.split(":") if p]
    kept = []
    actions = []

    replace_keys = set(HDR_X265_PARAMS.keys())

    for p in parts:
        key = p.split("=", 1)[0]
        if key not in replace_keys:
            kept.append(p)
        else:
            actions.append(f"REMOVED existing x265 param: {p}")

    for k, v in HDR_X265_PARAMS.items():
        kept.append(f"{k}={v}")
        actions.append(f"ADDED x265 param: {k}={v}")

    return ":".join(kept), actions


def classify_command(argv):
    joined = "\n".join(argv)

    vf = get_option_value(argv, {"-vf", "-filter:v", "-filter:v:0", "-filter_complex:v"})
    filter_complex = get_option_value(argv, {"-filter_complex"})

    has_hdr_to_sdr_vf = filter_contains_hdr_to_sdr_tonemap(vf)
    has_hdr_to_sdr_filter_complex = filter_contains_hdr_to_sdr_tonemap(filter_complex)
    has_vaapi_hdr_to_sdr_vf = bool(
        vf
        and "tonemap_vaapi=" in vf
        and "p=bt709" in vf
        and "t=bt709" in vf
        and "m=bt709" in vf
    )
    has_opencl_hdr_to_sdr_vf = bool(
        vf
        and "tonemap_opencl=" in vf
        and "p=bt709" in vf
        and "t=bt709" in vf
        and "m=bt709" in vf
    )

    video_encoder = get_option_value(argv, {"-codec:v:0", "-c:v:0", "-codec:v", "-c:v"})

    is_hw_pipeline = any(x in joined for x in [
        "hevc_qsv",
        "tonemap_vaapi",
        "procamp_vaapi",
        "hwmap=derive_device=qsv",
        "format=qsv",
    ])

    is_supported_vaapi_qsv_pipeline = bool(
        video_encoder == "hevc_qsv"
        and has_vaapi_hdr_to_sdr_vf
        and vf
        and "hwmap=derive_device=qsv" in vf
        and "format=qsv" in vf
        and "-hwaccel_output_format\nvaapi" in joined
    )

    return {
        "video_encoder": video_encoder,
        "has_filter_complex": filter_complex is not None,
        "has_hdr_to_sdr_vf": has_hdr_to_sdr_vf,
        "has_hdr_to_sdr_filter_complex": has_hdr_to_sdr_filter_complex,
        "has_vaapi_hdr_to_sdr_vf": has_vaapi_hdr_to_sdr_vf,
        "has_opencl_hdr_to_sdr_vf": has_opencl_hdr_to_sdr_vf,
        "is_hw_pipeline": is_hw_pipeline,
        "is_supported_vaapi_qsv_pipeline": is_supported_vaapi_qsv_pipeline,
    }


def rewrite_vaapi_qsv_hdr_to_hdr(argv, report):
    out = argv[:]
    changed_filter = False

    for index in range(len(out) - 1):
        if out[index] in {"-vf", "-filter:v", "-filter:v:0"}:
            rewritten_filter, message = replace_vaapi_tonemap_with_hdr(out[index + 1])
            if rewritten_filter == out[index + 1]:
                report["hdr_to_hdr"].append(f"BAIL: hardware filter rewrite failed: {message}")
                return argv
            out[index + 1] = rewritten_filter
            report["hdr_to_hdr"].append(f"HARDWARE_FILTER_REWRITE: {message}")
            changed_filter = True
            break

    if not changed_filter:
        report["hdr_to_hdr"].append("BAIL: VAAPI/QSV filter was not found during rewrite")
        return argv

    out, actions = set_or_add_option(out, ["-profile:v:0", "-profile:v"], "main10")
    report["hdr_to_hdr"].extend(actions)

    for option, value in [
        ("-color_primaries", "bt2020"),
        ("-color_trc", "smpte2084"),
        ("-colorspace", "bt2020nc"),
        ("-color_range", "tv"),
    ]:
        out, actions = set_or_add_option(out, [option], value)
        report["hdr_to_hdr"].extend(actions)

    report["hdr_to_hdr"].append("SUCCESS: HDR_TO_HDR_REWRITE_APPLIED (VAAPI/QSV)")
    return out


def rewrite_hdr_to_hdr(argv, report, client_decision, source_decision):
    """
    Rewrite Jellyfin software HDR->SDR tonemapx command into HDR->HDR.
    Returns rewritten argv.
    """
    if ENABLE_HDR_TO_HDR != 1:
        report["hdr_to_hdr"].append("DISABLED: ENABLE_HDR_TO_HDR=0")
        return argv

    info = classify_command(argv)

    report["hdr_to_hdr"].append("ENABLED: ENABLE_HDR_TO_HDR=1")
    report["hdr_to_hdr"].append(f"COMMAND_CLASSIFICATION: {info}")

    if (
        source_decision.get("probe_attempted")
        and not source_decision.get("allow_hdr_preservation")
    ):
        report["hdr_to_hdr"].append(
            "BAIL: source safety probe did not allow HDR preservation: "
            + source_decision.get("reason", "unknown reason")
        )
        return argv

    if info["is_supported_vaapi_qsv_pipeline"]:
        if info["has_filter_complex"]:
            report["hdr_to_hdr"].append(
                "BAIL: VAAPI/QSV HDR rewrite does not support -filter_complex"
            )
            return argv
        if not client_decision.get("allow_hdr_to_hdr"):
            report["hdr_to_hdr"].append(
                "BAIL: blocking client decision did not allow HDR->HDR: "
                + client_decision.get("reason", "unknown reason")
            )
            return argv
        return rewrite_vaapi_qsv_hdr_to_hdr(argv, report)

    if info["is_hw_pipeline"]:
        report["hdr_to_hdr"].append(
            "BAIL: unsupported hardware filter graph; supported hardware path is VAAPI HDR input to QSV Main10"
        )
        return argv

    if info["video_encoder"] != "libx265":
        report["hdr_to_hdr"].append(
            f"BAIL: video encoder is {info['video_encoder']!r}; v1 only handles libx265"
        )
        return argv

    if info["has_filter_complex"]:
        if info["has_hdr_to_sdr_filter_complex"]:
            if ENABLE_FILTER_COMPLEX_HDR_TO_HDR == 1:
                report["hdr_to_hdr"].append(
                    "BAIL: ENABLE_FILTER_COMPLEX_HDR_TO_HDR=1 but filter_complex rewrite is not implemented safely yet"
                )
            else:
                report["hdr_to_hdr"].append(
                    "BAIL: HDR->SDR tonemap found inside -filter_complex; "
                    "this is usually subtitle burn-in/overlay. "
                    "ENABLE_FILTER_COMPLEX_HDR_TO_HDR=0, so passing through."
                )
        else:
            report["hdr_to_hdr"].append(
                "BAIL: -filter_complex present but no HDR->SDR tonemap markers found"
            )
        return argv

    if not info["has_hdr_to_sdr_vf"]:
        report["hdr_to_hdr"].append(
            "BAIL: no simple -vf/-filter:v Jellyfin HDR->SDR tonemapx filter found"
        )
        return argv

    if not client_decision.get("allow_hdr_to_hdr"):
        report["hdr_to_hdr"].append(
            "BAIL: blocking client decision did not allow HDR->HDR: "
            + client_decision.get("reason", "unknown reason")
        )
        return argv

    out = argv[:]
    changed_filter = False

    filter_options = {
        "-vf",
        "-filter:v",
        "-filter:v:0",
        "-filter_complex:v",
    }

    i = 0
    while i < len(out):
        if out[i] in filter_options and i + 1 < len(out):
            original_filter = out[i + 1]

            if is_hdr_to_sdr_filter(original_filter):
                out[i + 1], replacement_msg = replace_tonemapx_with_hdr_to_hdr(original_filter)
                report["hdr_to_hdr"].append(f"FILTER_REWRITE: {out[i]} {replacement_msg}")
                changed_filter = True

            i += 2
        else:
            i += 1

    if not changed_filter:
        report["hdr_to_hdr"].append(
            "BAIL: classification said HDR->SDR filter exists, but rewrite loop did not change anything"
        )
        return argv

    # Force HEVC Main10 output for HDR->HDR.
    out, actions = set_or_add_option(out, ["-profile:v:0", "-profile:v"], "main10")
    report["hdr_to_hdr"].extend(actions)

    out, actions = set_or_add_option(out, ["-pix_fmt"], "yuv420p10le")
    report["hdr_to_hdr"].extend(actions)

    # Force HDR output metadata.
    for opt, value in [
        ("-color_primaries", "bt2020"),
        ("-color_trc", "smpte2084"),
        ("-colorspace", "bt2020nc"),
        ("-color_range", "tv"),
    ]:
        out, actions = set_or_add_option(out, [opt], value)
        report["hdr_to_hdr"].extend(actions)

    # Patch x265 params for HDR signaling.
    patched_x265 = False
    i = 0
    while i < len(out):
        if out[i].startswith("-x265-params") and i + 1 < len(out):
            old_params = out[i + 1]
            out[i + 1], actions = rewrite_x265_params(out[i + 1])
            report["hdr_to_hdr"].append(f"UPDATED: {out[i]} for HDR signaling")
            report["hdr_to_hdr"].extend(actions)
            patched_x265 = True
            if old_params == out[i + 1]:
                report["hdr_to_hdr"].append("NOTE: x265 params text unchanged after patch")
            break
        i += 1

    if not patched_x265:
        # Add before output path.
        out = out[:-1] + [
            "-x265-params:0",
            ":".join(f"{k}={v}" for k, v in HDR_X265_PARAMS.items()),
        ] + out[-1:]
        report["hdr_to_hdr"].append("ADDED: -x265-params:0 HDR signaling params")

    report["hdr_to_hdr"].append("SUCCESS: HDR_TO_HDR_REWRITE_APPLIED")
    return out


def rewrite_argv(argv, report, client_decision, source_decision):
    if KILL_SWITCH == 1:
        report["global"].append("KILL_SWITCH=1: total passthrough")
        return argv, "KILL_SWITCH_PASSTHROUGH"

    out = argv[:]
    mode_parts = []

    if ENABLE_BITRATE_MIN == 1:
        out, minrate_changes = apply_minrate_from_maxrate(out)
        if minrate_changes:
            mode_parts.append("MINRATE_FROM_MAXRATE")
            report["bitrate_min"].append("ENABLED: ENABLE_BITRATE_MIN=1")
            report["bitrate_min"].extend(minrate_changes)
        else:
            mode_parts.append("NO_MINRATE_CHANGE")
            report["bitrate_min"].append(
                "ENABLED: ENABLE_BITRATE_MIN=1 but no parseable -maxrate was found"
            )
    else:
        mode_parts.append("BITRATE_MIN_DISABLED")
        report["bitrate_min"].append("DISABLED: ENABLE_BITRATE_MIN=0")

    before_hdr = out[:]
    out = rewrite_hdr_to_hdr(out, report, client_decision, source_decision)

    if out != before_hdr:
        mode_parts.append("HDR_TO_HDR_REWRITE_APPLIED")
    else:
        mode_parts.append("HDR_TO_HDR_NOT_APPLIED")

    return out, " + ".join(mode_parts)


def log_report(report, original, rewritten, mode):
    log("================================================================================")
    log("==== " + datetime.now().isoformat() + " ====")
    log("CONFIG:")
    log(f"  CONFIG_FILE={CONFIG_FILE!r}")
    log(f"  CONFIG_LOAD_ERROR={CONFIG_LOAD_ERROR!r}")
    log(f"  REAL_FFMPEG={REAL_FFMPEG!r}")
    log(f"  FFPROBE_BINARY={FFPROBE_BINARY!r}")
    log(f"  LOG_FILE={LOG_FILE!r}")
    log(f"  KILL_SWITCH={KILL_SWITCH}")
    log(f"  ENABLE_HDR_TO_HDR={ENABLE_HDR_TO_HDR}")
    log(f"  ENABLE_BITRATE_MIN={ENABLE_BITRATE_MIN}")
    log(f"  ENABLE_BLOCKING_CLIENT_DECISION={ENABLE_BLOCKING_CLIENT_DECISION}")
    log(f"  ENABLE_FILTER_COMPLEX_HDR_TO_HDR={ENABLE_FILTER_COMPLEX_HDR_TO_HDR}")
    log(f"  MINRATE_RATIO={MINRATE_RATIO}")
    log(f"MODE: {mode}")

    log(f"  HDR_ALLOW_LIST={HDR_ALLOW_LIST}")
    log(f"  HDR_DENY_LIST={HDR_DENY_LIST}")

    for section in ["global", "source_probe", "blocking_client_decision", "bitrate_min", "hdr_to_hdr"]:
        entries = report.get(section) or []
        log(f"{section.upper()}:")
        if entries:
            for entry in entries:
                log(f"  - {entry}")
        else:
            log("  - no entries")

    if LOG_FULL_ARGV == 1:
        log("ORIGINAL_ARGV:")
        log("  " + shell_join([REAL_FFMPEG] + original))

        if rewritten != original:
            log("REWRITTEN_ARGV:")
            log("  " + shell_join([REAL_FFMPEG] + rewritten))
        else:
            log("REWRITTEN_ARGV:")
            log("  unchanged / passthrough")

    if ENABLE_HDR_TO_HDR == 1:
        if rewritten != original and any("SUCCESS: HDR_TO_HDR_REWRITE_APPLIED" in x for x in report["hdr_to_hdr"]):
            log("HDR_TO_HDR_STATUS: ENABLED_AND_APPLIED")
        else:
            log("HDR_TO_HDR_STATUS: ENABLED_BUT_NOT_APPLIED_SEE_BAIL_REASON")
    else:
        log("HDR_TO_HDR_STATUS: DISABLED")

    log("")


def main():
    if sys.argv[1:] == ["--check-config"]:
        print(json.dumps({
            "config_file": CONFIG_FILE,
            "config_load_error": CONFIG_LOAD_ERROR,
            "kill_switch": KILL_SWITCH,
            "real_ffmpeg": REAL_FFMPEG,
            "ffprobe_binary": FFPROBE_BINARY,
            "log_file": LOG_FILE,
        }, indent=2, sort_keys=True))
        return

    original = sys.argv[1:]

    report = {
        "global": [],
        "source_probe": [],
        "blocking_client_decision": [],
        "bitrate_min": [],
        "hdr_to_hdr": [],
    }

    if KILL_SWITCH == 1:
        report["global"].append("KILL_SWITCH=1: not calling Jellyfin and not rewriting argv")
        rewritten = original
        mode = "KILL_SWITCH_PASSTHROUGH"
        log_report(report, original, rewritten, mode)
        os.execv(REAL_FFMPEG, [REAL_FFMPEG] + rewritten)

    command_info = classify_command(original)
    is_source_probe_candidate = bool(
        ENABLE_HDR_TO_HDR == 1
        and not command_info["has_filter_complex"]
        and (
            command_info["has_hdr_to_sdr_vf"]
            or command_info["has_vaapi_hdr_to_sdr_vf"]
            or command_info["has_opencl_hdr_to_sdr_vf"]
        )
    )

    is_rewrite_candidate = (
        ENABLE_HDR_TO_HDR == 1
        and (
            command_info["has_hdr_to_sdr_vf"]
            or command_info["is_supported_vaapi_qsv_pipeline"]
        )
        and not command_info["has_filter_complex"]
        and (
            command_info["video_encoder"] == "libx265"
            or command_info["is_supported_vaapi_qsv_pipeline"]
        )
    )

    if is_source_probe_candidate:
        source_decision = probe_source_hdr_compatibility(original, report)
        if source_decision["allow_hdr_preservation"] and is_rewrite_candidate:
            client_decision = blocking_client_decision(original, report)
        elif source_decision["allow_hdr_preservation"]:
            client_decision = {
                "allow_hdr_to_hdr": False,
                "reason": "command uses an unsupported rewrite pipeline",
            }
            report["blocking_client_decision"].append(
                "SKIPPED: command uses an unsupported rewrite pipeline"
            )
        else:
            client_decision = {
                "allow_hdr_to_hdr": False,
                "reason": "source safety probe denied HDR preservation",
            }
            report["blocking_client_decision"].append(
                "SKIPPED: source safety probe denied HDR preservation"
            )
    else:
        source_decision = {
            "allow_hdr_preservation": False,
            "reason": "command is not a supported HDR->SDR rewrite candidate",
            "probe_attempted": False,
        }
        client_decision = {
            "allow_hdr_to_hdr": False,
            "reason": "command is not a supported HDR->SDR rewrite candidate",
        }
        report["blocking_client_decision"].append(
            "SKIPPED: command is not a supported HDR->SDR rewrite candidate"
        )

    rewritten, mode = rewrite_argv(original, report, client_decision, source_decision)

    log_report(report, original, rewritten, mode)

    os.execv(REAL_FFMPEG, [REAL_FFMPEG] + rewritten)


if __name__ == "__main__":
    main()
