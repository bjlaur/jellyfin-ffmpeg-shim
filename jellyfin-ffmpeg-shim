#!/usr/bin/env python3

# =============================================================================
# Jellyfin FFmpeg shim
# =============================================================================
#
# Mode flags:
#
#   KILL_SWITCH = 1
#       Total passthrough. No bitrate rewrite, HDR rewrite, or API decision.
#
#   ENABLE_HDR_TO_HDR = 1
#       Rewrite Jellyfin software HDR->SDR tonemapx commands into HDR->HDR.
#
#   ENABLE_BITRATE_MIN = 1
#       If Jellyfin passes -maxrate X, add/update -minrate to MINRATE_RATIO * X.
#
#   ENABLE_FILTER_COMPLEX_HDR_TO_HDR = 0
#       v1 does NOT rewrite filter_complex / subtitle burn-in graphs.
#       Keep this 0 until we intentionally implement that path.
#
#   LOG_FULL_ARGV = 1
#       Log original and rewritten full FFmpeg argv.
#
# =============================================================================

import os
import sys
import shlex
import re
import subprocess
import json
import time
import urllib.request
from datetime import datetime


CONFIG_FILE = os.environ.get("JELLYFIN_SHIM_CONFIG", "/etc/jellyfin/shim.json")
CONFIG_LOAD_ERROR = None

# Fail-safe state used only until JSON configuration loads. The FFmpeg path is
# the single intentional deployment fallback so invalid configuration can still
# provide total passthrough.
EMERGENCY_REAL_FFMPEG = "/usr/lib/jellyfin-ffmpeg/ffmpeg"
EMERGENCY_LOG_FILE = "/var/log/jellyfin/jellyfin-ffmpeg-shim.log"
KILL_SWITCH = True
REAL_FFMPEG = EMERGENCY_REAL_FFMPEG
FFPROBE_BINARY = None
LOG_FILE = EMERGENCY_LOG_FILE
ENABLE_HDR_TO_HDR = False
ENABLE_BITRATE_MIN = False
ENABLE_BLOCKING_CLIENT_DECISION = False
ENABLE_FILTER_COMPLEX_HDR_TO_HDR = False
LOG_FULL_ARGV = False
MINRATE_RATIO = None
JELLYFIN_URL = None
JELLYFIN_API_KEY = ""
BLOCKING_DECISION_POLL_DELAYS_SECONDS = None
BLOCKING_DECISION_API_TIMEOUT_SECONDS = None
SOURCE_PROBE_TIMEOUT_SECONDS = None
HDR_ALLOW_LIST = []
HDR_DENY_LIST = []
_LOG_FAILURE_REPORTED = False


def _config_bool(section, key):
    value = section[key]
    if not isinstance(value, bool):
        raise ValueError(f"{key} must be true or false")
    return value


def _config_number(section, key, *, minimum=0.0, maximum=None):
    value = section[key]
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{key} must be a number")
    value = float(value)
    if value < minimum or (maximum is not None and value > maximum):
        raise ValueError(f"{key} is outside the allowed range")
    return value


def _config_number_list(section, key):
    value = section[key]
    if (
        not isinstance(value, list)
        or not value
        or any(isinstance(item, bool) or not isinstance(item, (int, float)) for item in value)
    ):
        raise ValueError(f"{key} must be a non-empty array of numbers")
    result = [float(item) for item in value]
    if any(item < 0 for item in result) or result != sorted(result):
        raise ValueError(f"{key} must contain ascending non-negative values")
    return result


def _config_rules(value, key):
    if not isinstance(value, list):
        raise ValueError(f"{key} must be an array")
    rules = []
    for index, rule in enumerate(value):
        if not isinstance(rule, dict) or not isinstance(rule.get("username"), str):
            raise ValueError(f"{key}[{index}] must contain a string username")
        devices = rule.get("devices")
        if devices is not None and (
            not isinstance(devices, list)
            or not all(isinstance(device, str) for device in devices)
        ):
            raise ValueError(f"{key}[{index}].devices must be an array of strings")
        rules.append({
            "username": rule["username"],
            **({"devices": devices} if devices is not None else {}),
        })
    return rules


def load_config(path: str = CONFIG_FILE) -> None:
    global KILL_SWITCH, ENABLE_HDR_TO_HDR, ENABLE_BITRATE_MIN
    global ENABLE_BLOCKING_CLIENT_DECISION
    global ENABLE_FILTER_COMPLEX_HDR_TO_HDR, LOG_FULL_ARGV
    global JELLYFIN_URL, JELLYFIN_API_KEY
    global REAL_FFMPEG, FFPROBE_BINARY, LOG_FILE
    global MINRATE_RATIO, BLOCKING_DECISION_POLL_DELAYS_SECONDS
    global BLOCKING_DECISION_API_TIMEOUT_SECONDS
    global SOURCE_PROBE_TIMEOUT_SECONDS
    global HDR_ALLOW_LIST, HDR_DENY_LIST
    global CONFIG_LOAD_ERROR

    if not os.path.exists(path):
        KILL_SWITCH = 1
        CONFIG_LOAD_ERROR = f"config file missing: {path}"
        return

    try:
        with open(path, "r", encoding="utf-8") as config_file:
            config = json.load(config_file)
        if not isinstance(config, dict):
            raise ValueError("top-level config must be an object")

        shim = config["shim"]
        jellyfin = config["jellyfin"]
        paths = config["paths"]
        tuning = config["tuning"]
        hdr_access = config["hdr_access"]
        if not all(
            isinstance(section, dict) for section in (shim, jellyfin, paths, tuning, hdr_access)
        ):
            raise ValueError("shim, jellyfin, paths, tuning, and hdr_access must be objects")

        KILL_SWITCH = _config_bool(shim, "kill_switch")
        ENABLE_HDR_TO_HDR = _config_bool(shim, "enable_hdr_to_hdr")
        ENABLE_BITRATE_MIN = _config_bool(shim, "enable_bitrate_min")
        ENABLE_BLOCKING_CLIENT_DECISION = _config_bool(
            shim, "enable_blocking_client_decision"
        )
        ENABLE_FILTER_COMPLEX_HDR_TO_HDR = _config_bool(
            shim, "enable_filter_complex_hdr_to_hdr"
        )
        LOG_FULL_ARGV = _config_bool(shim, "log_full_argv")

        JELLYFIN_URL = jellyfin["url"]
        JELLYFIN_API_KEY = jellyfin["api_key"]
        if not isinstance(JELLYFIN_URL, str) or not isinstance(JELLYFIN_API_KEY, str):
            raise ValueError("jellyfin.url and jellyfin.api_key must be strings")
        JELLYFIN_URL = JELLYFIN_URL.strip()
        JELLYFIN_API_KEY = JELLYFIN_API_KEY.strip()

        REAL_FFMPEG = paths["ffmpeg_binary"]
        LOG_FILE = paths["log_file"]
        # Load the log path before newer required path fields so schema errors
        # can still be reported to the administrator's configured log.
        FFPROBE_BINARY = paths["ffprobe_binary"]
        if not all(
            isinstance(value, str) and value.strip()
            for value in (REAL_FFMPEG, FFPROBE_BINARY, LOG_FILE)
        ):
            raise ValueError("all configured paths must be non-empty strings")
        REAL_FFMPEG = REAL_FFMPEG.strip()
        FFPROBE_BINARY = FFPROBE_BINARY.strip()
        LOG_FILE = LOG_FILE.strip()

        MINRATE_RATIO = _config_number(
            tuning, "minrate_ratio", minimum=0.0, maximum=1.0
        )
        BLOCKING_DECISION_POLL_DELAYS_SECONDS = _config_number_list(
            tuning, "blocking_decision_poll_delays_seconds"
        )
        BLOCKING_DECISION_API_TIMEOUT_SECONDS = _config_number(
            tuning, "blocking_decision_api_timeout_seconds",
            minimum=0.01,
        )
        SOURCE_PROBE_TIMEOUT_SECONDS = _config_number(
            tuning, "source_probe_timeout_seconds", minimum=0.01
        )
        if not JELLYFIN_API_KEY or JELLYFIN_API_KEY == "PASTE_YOUR_API_KEY_HERE":
            KILL_SWITCH = 1
            CONFIG_LOAD_ERROR = "API key missing; forced KILL_SWITCH=1"
            return

        HDR_ALLOW_LIST = _config_rules(hdr_access["allow_list"], "allow_list")
        HDR_DENY_LIST = _config_rules(hdr_access["deny_list"], "deny_list")
        CONFIG_LOAD_ERROR = None
    except Exception as error:
        # Invalid configuration must result in total passthrough.
        KILL_SWITCH = 1
        REAL_FFMPEG = EMERGENCY_REAL_FFMPEG
        LOG_FILE = EMERGENCY_LOG_FILE
        JELLYFIN_API_KEY = ""
        CONFIG_LOAD_ERROR = (
            f"invalid config; forced KILL_SWITCH=1: {type(error).__name__}: {error}"
        )


load_config()


